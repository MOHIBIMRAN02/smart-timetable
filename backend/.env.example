# Database (SQLite by default, or Render PostgreSQL)
DATABASE_URL=sqlite:///./smart_timetable.db

# Security
SECRET_KEY=generate-a-random-32-char-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Origins (Allow Vercel frontend URL or wildcard *)
# Example: https://smart-timetable.vercel.app
ALLOWED_ORIGINS=*
